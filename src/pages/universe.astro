---
import { person } from '../data/home';
import { regions, systems, contentById } from '../universe/semantic';
import '../universe/universe.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#030508" />
    <title>Personal Universe — {person.name}</title>
    <meta name="description" content="An experimental spatial exploration of Junyu Chen's research interests and projects." />
    <link rel="canonical" href={new URL('/universe/', Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main id="universe" data-mode="reading" data-level="universe">
      <header class="universe-header">
        <a class="universe-signature" href="/">Junyu Chen <span>/ Personal Universe</span></a>
        <nav aria-label="Universe navigation">
          <button id="recenter" type="button" hidden>⌖ Back to focus</button>
          <button id="back" type="button" hidden>← Pull back</button>
          <button id="overview" type="button">Overview</button>
          <a href="/home/">Standard Website <span aria-hidden="true">↗</span></a>
        </nav>
      </header>
      <div id="space" hidden>
        <canvas id="universe-canvas" aria-label="Continuous three-dimensional universe. Scroll to fly through depth, drag to look around, or select spatial markers; Escape pulls back." tabindex="0"></canvas>
        <div id="space-labels" role="group" aria-label="Explore spatial regions, stellar systems, and celestial objects"></div>
        <section class="space-caption" aria-live="polite" aria-atomic="true">
          <p id="level-name" class="overline">01 / UNIVERSE · DEEP FIELD</p>
          <h1 id="target-name">Junyu's universe</h1>
          <p id="target-description">Scroll continuously to descend from intergalactic space into the spiral arms, stellar nurseries, and individual works.</p>
          <p id="content-description" hidden></p>
          <a id="content-link" href="/home/" hidden>Read on the Standard Website ↗</a>
        </section>
        <footer class="space-footer">
          <p id="interaction-hint">Move mouse for spatial parallax · drag to orbit 360° · scroll to zoom toward cursor · click to track</p>
          <button id="motion" type="button">Pause motion</button>
          <div class="scale-hud" aria-label="Continuous spatial depth scale">
            <span id="scale-readout" class="scale-readout" aria-hidden="true">DEPTH 0.00</span>
            <div class="scale-bar" aria-hidden="true"><div id="scale-progress-fill" class="scale-bar-fill"></div></div>
            <div class="scale-track">
              <button type="button" data-scale-depth="0" data-active="true">Universe</button>
              <button type="button" data-scale-depth="1.08">Galaxy</button>
              <button type="button" data-scale-depth="2.08">System</button>
              <button type="button" data-scale-depth="2.95">Content</button>
            </div>
          </div>
        </footer>
      </div>
      <section id="reading-view" class="reading-view">
        <p class="overline">Personal Universe / Spatial study 01</p>
        <h1>One person.<br />Connected directions.</h1>
        <p id="reading-message">This reading view connects the same interests and projects. The spatial view requires JavaScript and WebGL.</p>
        {Object.entries(regions).map(([id, region]) => (
          <section aria-labelledby={`reading-${id}`}>
            <h2 id={`reading-${id}`}>{region.title}</h2>
            <p>{region.description}</p>
            <ul>
              {region.systems.map(systemId => (
                <li><span>{systems[systemId].title}</span><div>
                  {systems[systemId].members.map(contentId => (
                    <a href={contentById[contentId].href}>{contentById[contentId].title} ↗</a>
                  ))}
                </div></li>
              ))}
            </ul>
          </section>
        ))}
      </section>
      <output id="universe-metrics" hidden aria-hidden="true"></output>
    </main>
    <script>
      import '../universe/entry';
    </script>
  </body>
</html>
